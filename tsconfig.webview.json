{
  "compilerOptions": {
    "module": "es2020",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "webview/dist/types",
    "rootDir": "webview/src",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["webview/src/**/*.ts"],
  "exclude": ["node_modules", "out", "webview/dist"]
}
